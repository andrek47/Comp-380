<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leaderboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- PODIUM SECTION -->
        <FrameLayout
            android:id="@+id/podium_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Podium Image -->
            <ImageView
                android:id="@+id/podium_image"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/podium" />

            <!-- Podium Text Overlays -->
            <!-- elevation=10dp forces text to be drawn on top of the image -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="10dp">

                <!-- 1st Place (Gold) - Moved UP to 115dp -->
                <TextView
                    android:id="@+id/txt_first"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D4AF37"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="130dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="165dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 2nd Place (Silver) - Moved UP to 75dp -->
                <TextView
                    android:id="@+id/txt_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="125dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="30dp" />

                <!-- 3rd Place (Bronze) - Moved UP to 55dp -->
                <TextView
                    android:id="@+id/txt_third"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CD7F32"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="105dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="30dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <!-- LIST SECTION (Card Style) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <TableLayout
                android:id="@+id/leaderboard_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1"
                android:shrinkColumns="2">

                <!-- Header Row -->
                <TableRow
                    android:background="#263238"
                    android:padding="12dp">

                    <TextView
                        android:text="RUNNER"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:layout_weight="1"
                        android:gravity="center_horizontal" />

                    <TextView
                        android:text="SCORE"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:layout_weight="1"
                        android:gravity="center_horizontal" />

                    <TextView
                        android:text="RANK"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:layout_weight="0.5"
                        android:gravity="center_horizontal" />
                </TableRow>

                <!-- ROW 1 -->
                <TableRow android:padding="12dp">
                    <TextView android:id="@+id/name1" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp"/>
                    <TextView android:id="@+id/score1" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/rank1" android:layout_weight="0.5" android:gravity="center" android:textColor="#666"/>
                </TableRow>
                <View android:layout_height="1dp" android:background="#EEEEEE"/>

                <!-- ROW 2 -->
                <TableRow android:padding="12dp">
                    <TextView android:id="@+id/name2" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp"/>
                    <TextView android:id="@+id/score2" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/rank2" android:layout_weight="0.5" android:gravity="center" android:textColor="#666"/>
                </TableRow>
                <View android:layout_height="1dp" android:background="#EEEEEE"/>

                <!-- ROW 3 -->
                <TableRow android:padding="12dp">
                    <TextView android:id="@+id/name3" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp"/>
                    <TextView android:id="@+id/score3" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/rank3" android:layout_weight="0.5" android:gravity="center" android:textColor="#666"/>
                </TableRow>
                <View android:layout_height="1dp" android:background="#EEEEEE"/>

                <!-- ROW 4 -->
                <TableRow android:padding="12dp">
                    <TextView android:id="@+id/name4" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp"/>
                    <TextView android:id="@+id/score4" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/rank4" android:layout_weight="0.5" android:gravity="center" android:textColor="#666"/>
                </TableRow>
                <View android:layout_height="1dp" android:background="#EEEEEE"/>

                <!-- ROW 5 -->
                <TableRow android:padding="12dp">
                    <TextView android:id="@+id/name5" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp"/>
                    <TextView android:id="@+id/score5" android:layout_weight="1" android:gravity="center" android:textColor="#333" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/rank5" android:layout_weight="0.5" android:gravity="center" android:textColor="#666"/>
                </TableRow>
            </TableLayout>
        </androidx.cardview.widget.CardView>

        <!-- Refresh Button -->
        <Button
            android:id="@+id/buttonRefreshLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh Leaderboard"
            android:backgroundTint="#009688"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>


        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
